{
  "name": "companion-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration --testTimeout=30000 --hookTimeout=120000",
    "start": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "db:migrate": "node --env-file-if-exists=.env dist/migrate.js",
    "smoke:enqueue": "node dist/smoke.js",
    "commercial": "node dist/commercial.js"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.5",
    "@fastify/type-provider-typebox": "6.3.0",
    "@prometheus-io/client": "0.16.1",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.8",
    "jose": "6.2.18",
    "kysely": "0.29.9",
    "pg": "8.23.1",
    "typebox": "1.4.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.15.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
