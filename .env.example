# Copy to .env and replace the database placeholders with local values.
# Load the file explicitly with Node's --env-file flag. See README.md.

# PostgreSQL
# Required by the API, worker, migrations, and database commands. Use a PostgreSQL connection URL.
DATABASE_URL=postgresql://your_user:your_password@127.0.0.1:5432/companion
# Maximum PostgreSQL connections per process (1–100, default 5).
DB_POOL_SIZE=5

# API
# API bind address. The default limits access to this machine. Use 0.0.0.0 inside a container if needed.
HOST=127.0.0.1
# API TCP port (1–65535, default 3000).
PORT=3000

# Metrics (optional)
# Set either port to enable that process's loopback-only Prometheus listener. Use distinct ports.
# API_METRICS_PORT=9101
# WORKER_METRICS_PORT=9102

# Identity (optional)
# Uncomment and configure all five AUTH_ settings together to enable identity routes.
# Exact HTTPS issuer URL from the identity provider, including its trailing slash if present.
# AUTH_ISSUER=https://identity.example.test/
# HTTPS URL for the provider's public signing keys (JWKS).
# AUTH_JWKS_URL=https://identity.example.test/jwks
# Audience that the provider sets on Companion API access tokens.
# AUTH_AUDIENCE=companion-api
# Comma-separated client IDs for attendee apps. Keep these separate from business client IDs.
# AUTH_B2C_CLIENT_IDS=attendee-web,attendee-android
# Comma-separated client IDs for business apps. Only business clients can call team routes.
# AUTH_B2B_CLIENT_IDS=business-web,business-android

# Razorpay sandbox webhooks (optional)
# Set both the sandbox account ID and current webhook signing secret to enable the inbox.
# Account ID expected in signed events from Razorpay.
# RAZORPAY_WEBHOOK_ACCOUNT_ID=acc_yourSandboxAccount
# Current webhook signing secret from Razorpay.
# RAZORPAY_WEBHOOK_SECRET=replace_with_sandbox_webhook_secret
# Previous signing secret during rotation. Remove it after the provider retry window.
# RAZORPAY_WEBHOOK_PREVIOUS_SECRET=replace_with_previous_webhook_secret

# Integration tests only
# Required by the integration suite. Use a fresh, disposable database because the suite writes data.
# TEST_DATABASE_URL=postgresql://your_user:your_password@127.0.0.1:5432/companion_test
